{
  "name": "engineering-standards",
  "version": "1.1.1",
  "private": true,
  "description": "Acadify Solution's versioned engineering handbook for Git, coding, security, peer review, and release practices.",
  "scripts": {
    "lint": "markdownlint \"**/*.md\" --ignore node_modules && npm run format:check",
    "lint:fix": "markdownlint \"**/*.md\" --ignore node_modules --fix && npm run format",
    "format": "prettier --write \"**/*.md\" \"**/*.json\"",
    "format:check": "prettier --check \"**/*.md\" \"**/*.json\"",
    "prepare": "husky"
  },
  "keywords": [
    "engineering-standards",
    "engineering-handbook",
    "developer-experience",
    "secure-software-development",
    "code-review",
    "release-management",
    "github",
    "husky",
    "markdownlint",
    "prettier"
  ],
  "author": "Acadify Solution <contact@acadifysolution.com> (https://acadifysolution.com)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "markdownlint-cli": "^0.41.0",
    "prettier": "^3.3.2"
  }
}